rules_version = '2';
// Bela Blok cloud (optional accounts). Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // usernames/{name in lowercase} = { uid, name }. Unique: a name can be created once and never changed.
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name.lower() == name
        && name.matches('[a-z0-9_.]{3,20}');
    }
    // games/{scorerUid}_{gameId} = { by, date, uids, g }. Only the phone owner who scored it writes it;
    // they and the players linked in it can read it.
    match /games/{id} {
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.uids || request.auth.uid == resource.data.by);
      allow create, update: if request.auth != null
        && id.matches(request.auth.uid + '_[A-Za-z0-9]+')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.g is string && request.resource.data.g.size() < 200000
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 4;
      allow delete: if request.auth != null && id.matches(request.auth.uid + '_[A-Za-z0-9]+');
    }
  }
}
